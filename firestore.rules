rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O administrador principal permanece como acesso de emergência e
    // autorização exclusiva para gerenciar a coleção de administradores.
    function isPrimaryAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hewertonluann@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Administradores adicionais são cadastrados pelo e-mail normalizado da
    // conta Firebase Authentication e precisam estar ativos.
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativo == true;
    }

    function isAdmin() {
      return isPrimaryAdmin() || isAuthorizedAdmin();
    }

    // O conteúdo institucional é público por natureza.
    match /site/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Os perfis públicos das congregações também precisam ser legíveis sem login,
    // mas somente o administrador pode criar, editar ou remover registros.
    match /congregacoes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notícias publicadas são públicas; rascunhos só ficam disponíveis para admins.
    // A home e a navegação pública usam where('publicado', '==', true).
    match /noticias/{document} {
      allow read: if isAdmin() || resource.data.publicado == true;
      allow write: if isAdmin();
    }

    // A lista de administradores nunca fica pública. Somente o administrador
    // principal pode criar, alterar, ativar, desativar ou remover registros.
    // Cada usuário autorizado pode ler apenas o registro do próprio e-mail.
    match /admins/{email} {
      allow get: if isPrimaryAdmin()
        || (request.auth != null
            && request.auth.token.email != null
            && request.auth.token.email_verified == true
            && email == request.auth.token.email);
      allow list: if isPrimaryAdmin();
      allow write: if isPrimaryAdmin();
    }
  }
}
